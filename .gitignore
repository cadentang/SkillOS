# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# 注意：仓库根的 build/ 是**编译发行管线源码目录**（docs/10），
# 所以这里不能写 `build/` —— 那会把它整个吃掉。只忽略其生成物。
build/out/
build/dist/
# 编译用的隔离 venv（含整套 Nuitka，65MB / 3556 文件）—— 绝不能被提交
build/.venv-build/
build/*.build/
build/*.onefile-build/
build/*.report.xml
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 本地数据库（表结构以 data/migrations 为准）
*.sqlite3
*.db

# Node
node_modules/
web/dist/
web/.vite/
web/tsconfig.tsbuildinfo

# 构建期从 web/dist 拷入的 SPA（setup.py 的 build_py 钩子生成，随 wheel 分发）
skillos/web_dist/

# setuptools 中间产物（build/ 本身是编译管线源码目录，只忽略生成物）
build/lib/
build/bdist/
build/*.egg-info/

# AI 辅助工具的项目级数据（计划/会话状态，非交付物）
.codebuddy/
.workbuddy/memory/

# 本地环境与凭据（NFR-2：token 禁止入项目目录）
.env
.env.*
*.local

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Skill OS 运行时产物
.skillos/
sandbox/runtime/
data/*.sqlite3
