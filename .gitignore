# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# 注意：仓库根的 build/ 是**编译发行管线源码目录**（docs/10），
# 所以这里不能写 `build/` —— 那会把它整个吃掉。只忽略其生成物。
build/out/
build/dist/
# 编译用的隔离 venv（含整套 Nuitka，65MB / 3556 文件）—— 绝不能被提交
build/.venv-build/
build/*.build/
build/*.onefile-build/
build/*.report.xml
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 本地数据库（表结构以 data/migrations 为准）
*.sqlite3
*.db

# Node
node_modules/
web/dist/
web/.vite/
web/tsconfig.tsbuildinfo

# 构建期从 web/dist 拷入的 SPA（setup.py 的 build_py 钩子生成，随 wheel 分发）
skillos/web_dist/

# setuptools 中间产物（build/ 本身是编译管线源码目录，只忽略生成物）
build/lib/
build/bdist/
build/*.egg-info/

# 比赛分享素材（PPT 二进制 / 可再生成的逐页预览图 / 配图，约 15MB）
# 只留 hackathon/作品介绍-SkillOS.md 入库；素材本地留存，需要归档时单独处理
hackathon/SkillOS分享/
hackathon/分享配图/
hackathon/_make_share_images.py
hackathon/_make_dup_figure.py

# AI 辅助工具的项目级数据（计划/会话状态，非交付物）
.codebuddy/
.workbuddy/memory/
# 设计稿（HTML 原型，非交付物）
.workbuddy/design/

# 本地环境与凭据（NFR-2：token 禁止入项目目录）
.env
.env.*
*.local

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Skill OS 运行时产物
.skillos/
sandbox/runtime/
data/*.sqlite3

# 一体化发行包解到仓库根的内容（README/SKILL/manifest/scripts/references/vendor 属发行包，
# 不是本仓库源码；vendor/ 下还有随平台而异的便携 CPython / MinGit 大件）
/README.md
/SKILL.md
/manifest.json
/scripts/
/references/
/vendor/
# bootstrap 解出来的前端产物（与 skillos/web_dist/ 同性质，可由归档重建）
/web_dist/
